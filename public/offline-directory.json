  "firstAidProtocol": {
    "dos": [
      "Keep victim calm and still; immobilize bitten limb like a fracture.",
      "Remove rings, watches, bangles, and tight clothing before swelling starts.",
      "Dial 108 / 112 immediately and transport to nearest government/tertiary hospital with ASV."
    ],
    "donts": [
      "NEVER tie a tight tourniquet or rope.",
      "NEVER cut, slash, or try to suck venom from the wound.",
